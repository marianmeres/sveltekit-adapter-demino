{
	// Editor + `pnpm run typecheck` view: src and tests, no output. Node runs the
	// source with its types stripped and never checks them, so this is the type gate.
	// example/ is left out: example/server.ts imports the SvelteKit build output,
	// which exists only after `pnpm run example:build`.
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"types": ["node"],

		"strict": true,
		"skipLibCheck": true,

		// erasable-only TS: what Node's type stripping can run unchanged
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		// imports keep their `.ts` extension in source; tsc rewrites them to `.js` on emit
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,

		"noEmit": true
	},
	"include": ["src", "tests"]
}
